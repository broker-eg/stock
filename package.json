    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
